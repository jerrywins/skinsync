{
 "title": "SkinSync API",
 "uid": "skinsync-api",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(skinsync_http_requests_total[5m]))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(skinsync_http_request_seconds_bucket[5m])))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error rate (5xx share)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(skinsync_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(skinsync_http_requests_total[5m]))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Comparison cache hit rate",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(skinsync_cache_total{result=\"hit\"}[15m])) / sum(rate(skinsync_cache_total[15m]))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Background jobs by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (type, outcome) (rate(skinsync_jobs_total[15m]))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Rejected uploads by reason",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (code) (rate(skinsync_upload_rejections_total[1h]))",
     "refId": "A",
     "legendFormat": "{{route}}"
    }
   ]
  }
 ]
}