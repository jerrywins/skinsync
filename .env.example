# Copy to .env and fill in. Never commit .env.
# Generate secrets:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"            -> SKINSYNC_SECRET_KEY
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())" -> SKINSYNC_IMAGE_ENCRYPTION_KEY
POSTGRES_PASSWORD=change-me-postgres
SKINSYNC_SECRET_KEY=change-me-to-a-48-character-random-string-before-use
SKINSYNC_IMAGE_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvY2FsLXVzZSE=
SKINSYNC_ENV=dev
SKINSYNC_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost
SITE_ADDRESS=:80
# Fictional demo dataset (labelled DEMO everywhere). Never enable in production.
SKINSYNC_DEMO_MODE=true
# Skin model adapter:
#   "heuristic" = experimental colour/texture measurements, labelled "not validated" (default)
#   "mock"      = placeholder that does not look at skin; pairs with the DEMO knowledge (shows the full flow)
#   "none"      = analysis reports unavailable
SKINSYNC_SKIN_MODEL_ADAPTER=heuristic
# Created by `make seed`:
SKINSYNC_ADMIN_EMAIL=admin@example.com
SKINSYNC_ADMIN_PASSWORD=change-me-admin-passphrase
GRAFANA_ADMIN_PASSWORD=change-me
